# ==============================================================================
# Gig-Aid Environment Configuration Example
# Copy this file to .env and configure your secrets
# ==============================================================================

# GenAI API Configuration (store in Google Secret Manager for Cloud Run)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Settings (Cloud Run dynamically injects $PORT)
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Request Limits & Security
MAX_INPUT_LENGTH=4000
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=30.0
